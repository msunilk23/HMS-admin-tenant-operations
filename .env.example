# Application
ENVIRONMENT=development
DEBUG=true

# Security — CHANGE THIS in production (generate: openssl rand -hex 32)
SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-chars

# Database
DATABASE_URL=postgresql+asyncpg://hospital_user:replace-me@localhost:5433/hospital
# Docker Compose database interpolation (keep aligned with infra/postgres.env)
POSTGRES_USER=hospital_user
POSTGRES_DB=hospital
POSTGRES_DB_URL_PASSWORD=replace-me

# pgAdmin development login — replace before starting Compose
PGADMIN_DEFAULT_EMAIL=admin@hospital-dev.com
PGADMIN_DEFAULT_PASSWORD=change-me

# Redis
REDIS_URL=redis://localhost:6379

# CORS — comma-separated origins allowed
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Tenant-scoped provider integrations are configured via the Tenant
# Administration UI and stored as encrypted secret payloads.
# No provider credentials are kept in this file or in runtime envs.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

INTEGRATION_MASTER_KEY_FILE=
INTEGRATION_MASTER_KEY=
INTEGRATION_MASTER_KEY_TEST_ONLY=false
