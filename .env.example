# Application
ENVIRONMENT=development
DEBUG=true

# Security — CHANGE THIS in production (generate: openssl rand -hex 32)
SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-chars

# Database
DATABASE_URL=postgresql+asyncpg://hospital_user:hospital_pass@localhost:5433/hospital
# Docker Compose database interpolation (keep aligned with infra/postgres.env)
POSTGRES_USER=hospital_user
POSTGRES_DB=hospital
POSTGRES_DB_URL_PASSWORD=hospital_pass

# Redis
REDIS_URL=redis://localhost:6379

# CORS — comma-separated origins allowed
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Twilio (optional — for SMS/WhatsApp feedback notifications)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# Razorpay (optional — for online payments via POS kiosk)
# Get test keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary (optional — for lab report file storage)
# Get credentials from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
