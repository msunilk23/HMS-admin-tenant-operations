# Application
ENVIRONMENT=development
DEBUG=true

# Security — CHANGE THIS in production (generate: openssl rand -hex 32)
SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-chars

# Database
DATABASE_URL=postgresql+asyncpg://hospital_user:replace-me@localhost:5433/hospital
# Docker Compose database interpolation (keep aligned with infra/postgres.env)
POSTGRES_USER=hospital_user
POSTGRES_DB=hospital
POSTGRES_DB_URL_PASSWORD=replace-me

# pgAdmin development login — replace before starting Compose
PGADMIN_DEFAULT_EMAIL=admin@hospital-dev.com
PGADMIN_DEFAULT_PASSWORD=change-me

# Redis
REDIS_URL=redis://localhost:6379

# CORS — comma-separated origins allowed
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

